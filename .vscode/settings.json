{
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.git/**": true,
      "**/build/**": true,
      "**/dist/**": true,
      "**/output/**": true,
      "**/*.log": true,
      "**/.venv/**": true,
      "**/env/**": true,
      "**/__pycache__/**": true,
      "**/.DS_Store": true
    },
    "search.useIgnoreFiles": true,

        
    "search.exclude": {
      "**/node_modules/**": true,
      "**/.git/**": true,
      "**/.venv/**": true,
      "**/env/**": true,
      "**/__pycache__/**": true,
      "**/build/**": true,
      "**/dist/**": true,
      "**/output/**": true
    },

    "git.autorefresh": false,
    "git.decorations.enabled": false
    
  }